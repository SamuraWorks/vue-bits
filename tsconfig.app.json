{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/App.vue",
    "src/main.ts",
    "src/router/index.ts",
    "src/pages/LandingPage.vue",
    "src/components/landing/CTA/CTA.vue",
    "src/components/landing/Features/Features.vue",
    "src/components/landing/Footer/Footer.vue",
    "src/components/landing/Hero/Hero.vue",
    "src/components/landing/LandingLoader/LandingLoader.vue",
    "src/components/landing/LiveDemo/LiveDemo.vue",
    "src/components/landing/Navbar/Navbar.vue",
    "src/components/landing/Ownership/Ownership.vue",
    "src/components/landing/QuickStart/QuickStart.vue"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
